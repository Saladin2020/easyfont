# Makham 12 · มะขาม 12 — original pixel font for dialogue (Thai, Latin, Malay)
# Easy Font source (easyfont/1). Copyright 2026 Salahuddin Benno. SIL Open Font License 1.1.
#
# g <char | U+XXXX> <top row> [mark] [dx=N]   then the bitmap rows ('#' ink, '.' empty), a blank line ends it.
# Cell rows 0..17, baseline 15. Thai body rows 8-14, upper vowels 4-6, tone marks 0-2 (low form 4-6), lower vowels 16-17.
format easyfont/1
id makham-12
name Makham 12
th มะขาม 12
size 12
line 18
baseline 15
spacing 1
space 4
zones tone=0 upper=4 body=8 lower=16 lowshift=4 leftshift=2

